# App
APP_URL=https://eddiliciousfoods.co.uk

# Resend — OTP, newsletter, contact form, and complaints
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SITE_NOTIFY_EMAIL=eddiliciousfoods@gmail.com

# Google OAuth 2.0 (Web application — authorization code flow)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://eddiliciousfoods.co.uk/auth/google-callback.php

# Stripe — card payments (Checkout Session)
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio — WhatsApp order alerts to the owner
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_NOTIFY_WHATSAPP=+447424414028
TWILIO_WHATSAPP_ENABLED=true
TWILIO_WHATSAPP_NOTIFY_TEST_ORDERS=false

# Admin — comma-separated owner emails (must sign in with one of these)
ADMIN_EMAILS=owner@yourdomain.com

# Coming soon — public visitors see the landing page until you turn this off
SITE_UNDER_CONSTRUCTION=true
# Preview link: https://yoursite.co.uk/?preview=YOUR_KEY_HERE (sets a 30-day cookie)
SITE_PREVIEW_KEY=change-this-to-a-long-random-secret

# Licence protection — set SITE_LICENSE_PAID=true when the client pays, or delete includes/site-license.php
SITE_LICENSE_START=2026-06-24
SITE_LICENSE_DAYS=33
SITE_LICENSE_PAID=false

# Website analytics
ANALYTICS_ENABLED=true
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=storage/ga4-credentials.json
